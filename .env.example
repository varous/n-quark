# PostgreSQL
POSTGRES_USER=nquark
POSTGRES_PASSWORD=nquark
POSTGRES_DB=nquark

# Neo4j (password must be at least 8 characters — Neo4j 5 requirement)
NEO4J_PASSWORD=nquarkdev

# MinIO
MINIO_ROOT_USER=nquark
MINIO_ROOT_PASSWORD=nquark

# Shared service defaults (override per service with NQUARK_ prefix)
NQUARK_LOG_LEVEL=info

# api-gateway service discovery: "local" (localhost:8001-8009) or "docker" (compose hostnames)
# Auto-detected when unset (.dockerenv -> docker, otherwise local)
NQUARK_NETWORK_MODE=local

# observation-service database (local dev with docker compose postgres on 5432)
NQUARK_POSTGRES_URL=postgresql+psycopg://nquark:nquark@localhost:5432/nquark

# signal-service → observation-service (local dev)
NQUARK_OBSERVATION_SERVICE_URL=http://localhost:8004

# Spotify Web API (optional, demoted to secondary signal; mock mode used when unset)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MOCK_MODE=true

# YouTube Data API (primary digital-popularity signal; mock mode used when key unset)
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=IN
YOUTUBE_MOCK_MODE=true

# MusicBrainz (open, no key; artist/label cross-reference + canonical MBID backbone).
# Mock mode on by default for local dev so ingest doesn't hit the rate-limited API.
MUSICBRAINZ_MOCK_MODE=true

# Google Trends — geographic demand signal. No reliable free API, so the provider is
# pluggable: "mock" (default), "dataforseo" (production reference), or "serpapi" (dev).
# Falls back to mock when the chosen provider's credentials are missing.
GOOGLE_TRENDS_PROVIDER=mock
GOOGLE_TRENDS_REGION=IN
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=

# Ticketing — live-event supply + demand ground truth (fill ratio = tickets sold / capacity).
# No single canonical API: "mock" (default, seeded with real Boshow data), "boshow"
# (public_scrape of the unauthenticated JSON API), or "bookmyshow" (partner-feed scaffold —
# bot-walled, raises until a data partnership exists).
TICKETING_PROVIDER=mock
