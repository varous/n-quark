# PostgreSQL
POSTGRES_USER=nquark
POSTGRES_PASSWORD=nquark
POSTGRES_DB=nquark

# Neo4j
NEO4J_AUTH=neo4j/nquark

# MinIO
MINIO_ROOT_USER=nquark
MINIO_ROOT_PASSWORD=nquark

# Shared service defaults (override per service with NQUARK_ prefix)
NQUARK_LOG_LEVEL=info

# api-gateway service discovery: "local" (localhost:8001-8009) or "docker" (compose hostnames)
# Auto-detected when unset (.dockerenv -> docker, otherwise local)
NQUARK_NETWORK_MODE=local

# observation-service database (local dev with docker compose postgres on 5432)
NQUARK_POSTGRES_URL=postgresql+psycopg://nquark:nquark@localhost:5432/nquark

# signal-service → observation-service (local dev)
NQUARK_OBSERVATION_SERVICE_URL=http://localhost:8004

# Spotify Web API (optional, demoted to secondary signal; mock mode used when unset)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MOCK_MODE=true

# YouTube Data API (primary digital-popularity signal; mock mode used when key unset)
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=IN
YOUTUBE_MOCK_MODE=true
